PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/minhtucenter

# JWT Configuration (Access Token & Refresh Token)
JWT_ACCESS_SECRET=minhtucenter_access_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=minhtucenter_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=minhtucenter_access_secret_key_change_in_production
JWT_EXPIRES_IN=15m

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# Google OAuth Configuration (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase Configuration
# Cách 1: Sử dụng đường dẫn file serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=
# Cách 2: Nhập trực tiếp thông tin từ Service Account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Web API Key (lấy trong Project Settings > General > Web API Key)
# Dùng để gửi trực tiếp email xác thực qua hệ thống Firebase Auth REST API
FIREBASE_WEB_API_KEY=AIzaSy...

# Cấu hình OTP & Mail
OTP_SECRET=minhtucenter_otp_secret_key_change_in_production
OTP_EXPIRES_IN_MINUTES=5
MAIL_SENDER_NAME="Minh Tu"
MAIL_SENDER_EMAIL=no-reply@minhtucenter.com

# Cấu hình SMTP (Gmail hoặc SMTP Server để gửi email OTP thật từ "Minh Tu")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=false
